{
	"name": "drakriddarna",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"benchmark": "BENCHMARK=true vitest run src/benchmark/benchmark.test.ts",
		"benchmark:rendering": "BENCHMARK=true vitest run src/benchmark/renderingBenchmark.test.ts",
		"balanceAnalysis": "BENCHMARK=true vitest run src/benchmark/balanceAnalysis.test.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prettier": "prettier --plugin-search-dir . --check . ",
		"prettier:format": "prettier --plugin-search-dir . --write .",
		"deploy": "npm run build && npx gh-pages -d build -t",
		"exportCatalog": "node scripts/export-editor-catalog.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@types/node": "^22.20.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.0.0",
		"eslint-plugin-svelte": "^3.24.0",
		"gh-pages": "^6.0.0",
		"globals": "^17.14.0",
		"prettier": "^3.1.0",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.10.1",
		"tslib": "^2.4.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"type": "module",
	"dependencies": {
		"@hoard-engine/audio": "^0.1.0",
		"@hoard-engine/directors": "^0.1.0",
		"@hoard-engine/grid": "^0.1.0",
		"@hoard-engine/lighting": "^0.1.0",
		"@hoard-engine/primitives": "^0.1.0",
		"@hoard-engine/rng": "^0.1.0",
		"@hoard-engine/saves": "^0.1.0",
		"@sveltekit-i18n/extension-stores": "^3.2.1",
		"sveltekit-i18n": "^3.4.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
