{
	"name": "drakriddarna",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"benchmark": "BENCHMARK=true vitest run src/benchmark/benchmark.test.ts",
		"benchmark:rendering": "BENCHMARK=true vitest run src/benchmark/renderingBenchmark.test.ts",
		"balanceAnalysis": "BENCHMARK=true vitest run src/benchmark/balanceAnalysis.test.ts",
		"lint": "eslint  -c .eslintrc.cjs --ext .ts .",
		"lint:fix": "eslint -c .eslintrc.cjs --fix --ext .ts .",
		"prettier": "prettier --plugin-search-dir . --check . ",
		"prettier:format": "prettier --plugin-search-dir . --write .",
		"deploy": "npm run build && npx gh-pages -d build -t true",
		"exportCatalog": "node scripts/export-editor-catalog.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@typescript-eslint/eslint-plugin": "^5.45.0",
		"@typescript-eslint/parser": "^5.45.0",
		"eslint": "^8.49.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"eslint-plugin-svelte": "^2.30.0",
		"gh-pages": "^6.0.0",
		"prettier": "^3.0.3",
		"prettier-plugin-svelte": "^3.0.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tslib": "^2.4.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"type": "module",
	"dependencies": {
		"@hoard-engine/grid": "^0.1.0",
		"@hoard-engine/rng": "^0.1.0",
		"sveltekit-i18n": "^2.4.2"
	}
}
